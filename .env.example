# Copy to .env (git-ignored) and edit. Real environment variables override these.

# --- server ---
HOST=0.0.0.0              # 0.0.0.0 = reachable on your LAN; 127.0.0.1 = this machine only
PORT=8787
MODEL=tev1:4b             # Ollama model name (hosted providers use their own *_MODEL below)
VARIANT=prose             # default game mode: prose | data | policy:careful | policy:fuel-miser | policy:aggressive
TIME_SCALE=1

# --- Ollama (tested) ---
OLLAMA_URL=http://localhost:11434   # primary Ollama with /v1/systemone
# OLLAMA_LABEL=GPU box
# OLLAMA_URL2=http://localhost:11434 # optional secondary; automatic fallback if the primary is unreachable
# OLLAMA_LABEL2=laptop

# Default host for the UI/headless: primary | secondary | jev | msd1 | openrouter
PROVIDER=primary

# --- hosted decision models (UNTESTED adapters, see README "Using other decision models") ---
# TypeSafe Jev
# JEV_API_KEY=
# JEV_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# Microsoft-Decision-1 on Azure Foundry
# AZURE_ENDPOINT=https://<your-resource>.services.ai.azure.com
# AZURE_API_KEY=
# AZURE_DEPLOYMENT=<your deployment name>
# Microsoft-Decision-1 via OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=microsoft/microsoft-decision-1
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/v1/decisions
